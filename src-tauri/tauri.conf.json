{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Studio",
  "version": "0.4.2",
  "identifier": "com.aiwarroom.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AI作战室",
        "width": 600,
        "height": 500,
        "resizable": false,
        "center": true,
        "decorations": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bin/one-api.exe"],
    "externalBin": ["bin/one-api"]
  }
}
